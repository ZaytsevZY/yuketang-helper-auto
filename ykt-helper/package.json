{
  "name": "ykt-helper-userscript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "debug": "npm run build && node scripts/debug-server.mjs",
    "debug:serve": "node scripts/debug-server.mjs",
    "test:debug": "npm run build && node scripts/verify-debug-harness.mjs",
    "test:debug:browser": "node scripts/verify-debug-browser.mjs",
    "test:model-params": "node scripts/verify-model-params.mjs",
    "test": "node --test test/*.test.js",
    "postbuild": "node -e \"import('./rollup.config.mjs').then(({ OUT_FILE, DEBUG_OUT_FILE }) => console.log('\\n✅ Build done: ' + OUT_FILE + ' + ' + DEBUG_OUT_FILE))\""
  },
  "devDependencies": {
    "@bkuri/rollup-plugin-string": "^1.0.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.21.2",
    "typescript": "^5.6.3"
  }
}
